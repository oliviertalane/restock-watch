# Copy the values you need into the Railway service variables (or export them locally).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
WATCH_URLS="https://store.example/collections/new-arrivals
https://other-store.example/products/some-product"
SCAN_INTERVAL_MINUTES=10
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=
ALERT_SOLD_OUT_NEW=true
TZ=UTC
HEARTBEAT_HOUR=9
# Local runs only: where the state file goes (Railway uses the volume automatically)
DATA_DIR=./data
